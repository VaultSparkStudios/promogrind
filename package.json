{
  "name": "promogrind",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/optimize-images.mjs",
    "build": "vite build",
    "build:pages": "vite build && node scripts/postbuild-pages.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "build:cap": "vite build --outDir dist-cap",
    "cap:sync": "npm run build:cap && npx cap sync",
    "og": "node scripts/generate-og.mjs",
    "smoke:launch": "node scripts/validate-launch-smoke.mjs",
    "smoke:ux": "node scripts/validate-ux-route-integrity.mjs",
    "smoke:browser": "npm run build && node scripts/validate-browser-launch-smoke.mjs",
    "verify:launch-local": "npm test && npm run smoke:launch && npm run smoke:ux && npm run smoke:browser && node scripts/check-bundle-budget.mjs && node scripts/check-public-repo-sanitization.mjs --strict",
    "verify:production": "node scripts/verify-production-launch.mjs",
    "preview": "vite preview",
    "deploy:functions": "supabase functions deploy odds && supabase functions deploy create-checkout && supabase functions deploy stripe-webhook && supabase functions deploy weekly-digest",
    "deploy:brief": "supabase functions deploy send-daily-brief",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@sentry/react": "^10.48.0",
    "@supabase/supabase-js": "^2.100.0",
    "posthog-js": "^1.367.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/ui": "^4.1.2",
    "happy-dom": "^20.9.0",
    "sharp": "^0.34.5",
    "vite": "^6.0.0",
    "vitest": "^4.1.2"
  }
}
