# PromoGrind — Environment Variables
# Copy this file to .env and fill in your values.
# Find Supabase values at: supabase.com → your project → Settings → API

# ── Required ──────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# ── GitHub Pages build (set in repo secrets, not locally) ─────────────────────
# VITE_APP_BASE_PATH=/promogrind/
# Used by: vite.config.js, src/sw-register.js

# ── Frontend launch-state flags (public, safe to expose) ──────────────────────
# Use these to hide or beta-label surfaces until backend/setup work is complete.
# Set to true only when the corresponding backend/service is actually live.
# VITE_PG_FEATURE_AI_SCAN=false
# VITE_PG_FEATURE_PROMO_ADVISOR=false
# VITE_PG_FEATURE_PROMO_CHAT=false
# VITE_PG_FEATURE_LIVE_SCANNER=false
# VITE_PG_FEATURE_STACK_BUILDER=false
# VITE_PG_FEATURE_AI_ACTION_PLAN=false
# VITE_PG_FEATURE_PUSH_ALERTS=false
# VITE_PG_FEATURE_PAID_CHECKOUT=false

# ── Edge Function Secrets (set via: supabase secrets set KEY=value) ───────────
# These are NOT prefixed with VITE_ — they are server-side only.

# The Odds API (theoddsapi.com) — required for LiveScanner
# ODDS_API_KEY=your_odds_api_key

# Stripe — required for VaultSparked checkout
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_MONTHLY_PRICE_ID=price_...
# STRIPE_ANNUAL_PRICE_ID=price_...

# Resend — required for weekly-digest newsletter
# RESEND_API_KEY=re_...

# VAPID — required for server-sent push notifications (future send-daily-brief function)
# VAPID_PUBLIC_KEY=...
# VAPID_PRIVATE_KEY=...
# VAPID_SUBJECT=mailto:hello@vaultsparkstudios.com

# ── Analytics (build-time, safe to expose) ────────────────────────────────────
# PostHog — behavioral analytics, funnel tracking, user identity
# VITE_POSTHOG_KEY=phx_...

# Sentry — error monitoring + session replay (only active in production builds)
# Create a project at sentry.io → Organisation: vaultspark-studios → New Project → React
# VITE_SENTRY_DSN=https://...@....ingest.sentry.io/...

# ── Admin CLI only (.env.admin) ───────────────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY — NEVER in browser code, never commit
